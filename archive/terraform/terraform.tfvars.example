# ============================================================
# CHAOS TYPE ZERO — Terraform Variables Example
# ============================================================
# Copy this file to terraform.tfvars and fill in values

# AWS Configuration
aws_region      = "us-east-1"
project_name    = "chaos-type-zero"
environment     = "dev"
instance_type   = "t3.medium"
key_pair_name   = "ctz-key"

# Network
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"

# Security
allowed_cidr_blocks = ["YOUR_IP/32"]  # Replace with your IP

# Database
db_password = "CHANGE_ME_STRONG_PASSWORD"

# Tags
tags = {
  Project     = "chaos-type-zero"
  Environment = "dev"
  ManagedBy   = "terraform"
  Version     = "3.2"
}

{
  "$schema": "https://opencode.ai/config.json",
  "username": "ctz-operator",
  "model": "ollama/llama3",
  "small_model": "ollama/llama3",
  "default_agent": "ctz",
  "shell": "powershell",
  "logLevel": "INFO",
  "share": "manual",
  "autoupdate": false,
  "instructions": [
    "SOUL_CTZ.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "agent": {
    "ctz": {
      "description": "CHAOS TYPE ZERO primary agent — autonomous AI OS with 3-tier memory, multi-provider LLM brain, multi-agent orchestration, and cryptographic provenance receipts.",
      "mode": "primary",
      "model": "ollama/llama3",
      "color": "error"
    },
    "ctz-code": {
      "description": "Code generation, review, and refactoring subagent.",
      "mode": "subagent",
      "model": "ollama/llama3"
    },
    "ctz-orchestrator": {
      "description": "Multi-agent coordination, task breakdown, and Sisyphus feedback loop.",
      "mode": "subagent",
      "model": "ollama/llama3"
    },
    "ctz-automation": {
      "description": "Scheduled jobs, triggers, event automations, and system workflows.",
      "mode": "subagent",
      "model": "ollama/llama3"
    },
    "ctz-reviewer": {
      "description": "Critic and verification agent with AST safety checking and cryptographic receipt audits.",
      "mode": "subagent",
      "model": "ollama/llama3"
    }
  },
  "mcp": {
    "ctz-file": {
      "type": "local",
      "command": [
        "python",
        "mcp_servers/file_mcp.py"
      ],
      "enabled": true
    },
    "ctz-git": {
      "type": "local",
      "command": [
        "python",
        "mcp_servers/git_mcp.py"
      ],
      "enabled": true
    },
    "ctz-web": {
      "type": "local",
      "command": [
        "python",
        "mcp_servers/web_mcp.py"
      ],
      "enabled": true
    },
    "ctz-playwright": {
      "type": "local",
      "command": [
        "python",
        "mcp_servers/playwright_mcp.py"
      ],
      "enabled": true
    },
    "ctz-api": {
      "type": "local",
      "command": [
        "python",
        "mcp_servers/api_mcp.py"
      ],
      "enabled": true
    },
    "ctz-automation": {
      "type": "local",
      "command": [
        "python",
        "mcp_servers/automation_mcp.py"
      ],
      "enabled": true
    },
    "ctz-context-bridge": {
      "type": "local",
      "command": [
        "python",
        "mcp_servers/context_bridge_mcp.py"
      ],
      "enabled": true
    },
    "ctz-orchestrator": {
      "type": "local",
      "command": [
        "python",
        "mcp_servers/ctz_orchestrator_mcp.py"
      ],
      "enabled": true
    },
    "ctz-vault": {
      "type": "local",
      "command": [
        "python",
        "mcp_servers/vault_mcp.py"
      ],
      "enabled": true
    },
    "ctz-monitor": {
      "type": "local",
      "command": [
        "python",
        "mcp_servers/monitor_mcp.py"
      ],
      "enabled": true
    }
  }
}
